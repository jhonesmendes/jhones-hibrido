{
  "name": "vocero-crm",
  "version": "1.1.0",
  "description": "CRM de WhatsApp proprietario y self-hosted con agente de IA y Laboratorio de auto-evaluación",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:demo": "esbuild scripts/seed/demo.ts --bundle --platform=node --format=esm --outfile=.tmp-seed-demo.mjs --alias:@=./src --packages=external && node .tmp-seed-demo.mjs",
    "recover:owner-password": "esbuild scripts/recover-owner-password.ts --bundle --platform=node --format=esm --outfile=.tmp-recover-owner-password.mjs --alias:@=./src --packages=external && node .tmp-recover-owner-password.mjs",
    "owner:invite": "esbuild scripts/bootstrap-owner.ts --bundle --platform=node --format=esm --outfile=.tmp-bootstrap-owner.mjs --alias:@=./src --packages=external && node .tmp-bootstrap-owner.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "^15.5.29",
    "nodemailer": "^10.3.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "typo-js": "^1.3.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/typo-js": "^1.2.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
